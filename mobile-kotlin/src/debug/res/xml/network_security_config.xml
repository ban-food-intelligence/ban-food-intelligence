<?xml version="1.0" encoding="utf-8"?>
<!-- Debug/demo builds only: the Go API may run on any LAN IP chosen in Settings
     (e.g. http://192.168.1.20:8080), so cleartext HTTP is allowed. Release builds use
     src/main/res/xml/network_security_config.xml, which allows only local hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
