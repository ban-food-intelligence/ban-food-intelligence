<?xml version="1.0" encoding="utf-8"?>
<!-- Release: cleartext HTTP only to the local Go API (USB via adb reverse, emulator host).
     Everything else, including the NVIDIA NIM endpoint, stays HTTPS-only.
     Debug builds override this file (src/debug) to also allow a LAN server IP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
